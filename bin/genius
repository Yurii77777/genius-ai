#!/usr/bin/env bash
# bin/genius                      start Claude Code in genius-ai with a first prompt (Claude speaks first)
# bin/genius save <folder>        pack the personal data (config, project rules, state) into a private archive
# bin/genius restore <archive>    unpack a save into this folder and bind it here (--force keeps the old data in backup/)
# bin/genius new                  clean start: move the personal data to backup/<date>/ (nothing deleted)
# bin/genius adopt                «this is my install»: bind a moved/copied config to this folder and Mac
# bin/genius where                show where the config was made and where it runs now
# bin/genius ops review | close <id> <why> | touch <id>   careful regular cleanup of pending operations
# bin/genius agents watch [start|stop|status]   the sub-agent watcher: sends the user's typed answer, alerts on waits (bin/lib/agents_watch.py)
# bin/genius pause|resume <name|tag>   pause a project (not checked, not reported) or bring it back
# bin/genius herdr install [--show] | uninstall | status   the status shelves in Herdr (bin/lib/herdr.py)
cd "$(dirname "$0")/.." || exit 1
case "${1:-}" in
  save|restore|new|adopt|where) exec /usr/bin/python3 bin/lib/install.py "$@" ;;
  herdr) shift; exec /usr/bin/python3 bin/lib/herdr.py "$@" ;;
  pause|resume) exec /usr/bin/python3 bin/lib/pause.py "$@" ;;
  ops) shift; exec /usr/bin/python3 bin/lib/ops.py "$@" ;;
  agents) shift; exec /usr/bin/python3 bin/lib/agents_watch.py "$@" ;;
  *) exec claude "Почни сесію genius-ai" "$@" ;;
esac
