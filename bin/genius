#!/usr/bin/env bash
# bin/genius                      start Claude Code in genius-ai with a first prompt (Claude speaks first)
# bin/genius save <folder>        pack the personal data (config, project rules, state) into a private archive
# bin/genius restore <archive>    unpack a save into this folder and bind it here (--force keeps the old data in backup/)
# bin/genius new                  clean start: move the personal data to backup/<date>/ (nothing deleted)
# bin/genius adopt                «this is my install»: bind a moved/copied config to this folder and Mac
# bin/genius where                show where the config was made and where it runs now
# bin/genius ops review | close <id> <why> | touch <id>   careful regular cleanup of pending operations
# bin/genius agents watch [start|stop|status]   the sub-agent watcher: sends the user's typed answer, alerts on waits (bin/lib/agents_watch.py)
# bin/genius agents overrule <id> | selftest | demo   the watcher's answer to an agent's question, and its checks (bin/lib/agent_ask.py)
# bin/genius pause|resume <name|tag>   pause a project (not checked, not reported) or bring it back
# bin/genius hold <name|tag> [why] | unhold <name|tag>   «take nothing new» for a project: a mark on its card
# bin/genius done "<text>" [--project <name>]   a finished job for the panel's «Done today» (bin/lib/focus.py)
# bin/genius focus …              the focus of the day and its steps, shown on top of the Herdr panel (bin/lib/focus.py)
# bin/heavy <who> -- <command>    one heavy run at a time; the panel shows the queue
# bin/genius log [import <transcript>]   the log of the day: the user's requests and the answers (bin/lib/daylog.py)
# bin/genius day [<date>|trend]   the day in numbers: tasks closed, requests, agents, the gate (bin/lib/daystats.py)
# bin/genius secret <NAME>       put one secret into the env file, typed without echo (bin/lib/secret.py)
# bin/genius models [--json]       what Claude, Codex and Ollama have left (bin/lib/models.py)
# bin/genius agent <model> <name> <folder> "<brief>"   a visible sub-agent on a model in Ollama (bin/lib/agent.py)
# bin/genius critic selftest | notes <folder> [<project>]   the critic that reads every brief before an agent
#                                 starts; it runs by itself on every start, never Claude judging Claude
# bin/genius selfcheck            fails when any start path of an agent skips the critic (bin/lib/selfcheck.py)
# bin/genius ticket critique <ref> | --dry <ref> | --sweep [--minutes N]   the critique of a ticket before an
#                                 autonomous engineer gets it (bin/lib/ticket.py)
# bin/genius ticket apply <ref> | --dry <ref>   write a finished critique into the ticket (tracker "apply_cmd")
# bin/genius pr resolve <owner/repo> <N>   a sub-agent merges the base (the authority) into a conflicting PR's branch; no push (bin/lib/prfix.py)
# bin/genius loop <owner/repo> <N> [--project p] [--max-rounds 4]   the fix↔review loop of one PR, by script;
#                                 the coordinator gets the final verdict only (bin/lib/review_loop.py)
# bin/genius load [one-stack|normal]   the load guard: no local stack while local model work runs (bin/lib/load.py)
# bin/genius gate log | test …    the gate that answers every action of an unattended agent (bin/lib/gate.py)
# bin/genius know search|add|ingest|stats   the knowledge base: local vector search over what the user said (bin/lib/know.py)
# bin/genius herdr install [--show] | uninstall | status   the status shelves in Herdr (bin/lib/herdr.py)
cd "$(dirname "$0")/.." || exit 1
case "${1:-}" in
  save|restore|new|adopt|where) exec /usr/bin/python3 bin/lib/install.py "$@" ;;
  herdr) shift; exec /usr/bin/python3 bin/lib/herdr.py "$@" ;;
  pause|resume|hold|unhold) exec /usr/bin/python3 bin/lib/pause.py "$@" ;;
  focus) shift; exec /usr/bin/python3 bin/lib/focus.py "$@" ;;
  done) shift; exec /usr/bin/python3 bin/lib/focus.py add-done "$@" ;;
  log) shift; exec /usr/bin/python3 bin/lib/daylog.py "$@" ;;
  know) shift; exec /usr/bin/python3 bin/lib/know.py "$@" ;;
  day) shift; exec /usr/bin/python3 bin/lib/daystats.py "$@" ;;
  secret) shift; exec /usr/bin/python3 bin/lib/secret.py "$@" ;;
  models) shift; exec /usr/bin/python3 bin/lib/models.py "$@" ;;
  agent) shift; exec /usr/bin/python3 bin/lib/agent.py "$@" ;;
  critic) shift; exec /usr/bin/python3 bin/lib/critic.py "$@" ;;
  selfcheck) exec /usr/bin/python3 bin/lib/selfcheck.py ;;
  ticket) shift; exec /usr/bin/python3 bin/lib/ticket.py "$@" ;;
  pr) shift; exec /usr/bin/python3 bin/lib/prfix.py "$@" ;;
  loop) shift; exec /usr/bin/python3 bin/lib/review_loop.py "$@" ;;
  load) shift; exec /usr/bin/python3 bin/lib/load.py "$@" ;;
  gate) shift; exec /usr/bin/python3 bin/lib/gate.py "$@" ;;
  ops) shift; exec /usr/bin/python3 bin/lib/ops.py "$@" ;;
  agents) shift; exec /usr/bin/python3 bin/lib/agents_watch.py "$@" ;;
  *) exec claude "Почни сесію genius-ai" "$@" ;;
esac
