#!/usr/bin/env python3
"""status — live state of every project and service in genius.config.json. Read-only, ~10 s.

    bin/status            one block per project (tag from projects/<name>/project.json), problems first
    bin/status --line     one short line per project (for the end of a reply)
    bin/status --json     machine-readable (the Herdr panel)

A project's open PRs are checked with one `gh pr list`: a conflicting PR (mergeable CONFLICTING /
DIRTY) is a problem «⚔️ PR #N», a PR behind its base with no update for "stale_pr_days" (project.json,
default 3) is a note. Self-check: python3 -I bin/status --selftest

A project with "paused" in its project.json is not checked and not printed; --json keeps it, marked.
"hold" there (the user's «take nothing new») only marks the card. "card": {"cmd": …} adds the lines of
the project's own read-only command to its card.

Per project: git branch, uncommitted files, ahead/behind upstream, open PRs, failed runs since the
last success, the running workflows, its URL services, and its pending operations (state/operations.json).
Once per run: GitHub's own status (githubstatus.com, component «Actions»): during an outage a failed run
is marked as «maybe GitHub, not the code».

genius-ai itself is one more entry, built from the operations with "project": "genius-ai" (the user's
decision of 2026-11-18: its own tasks belong to no configured project, so they never reached Attention).
Tag «⚙️ GA», spoken name «Геніус» (uk) or «Genius» (en), rank 0, marked "self": true in --json, no git,
PR or URL checks. It is absent while it has no operations, and the Herdr panel keeps it off the
Projects shelf. An operation of a project that is in neither place is printed once in the text form
(its group is missing), never dropped in silence.

    bin/status --pin "<service name>"   fetch and store the certificate of a service with
                          "expect": "untrusted-cert" (state/certs/<name>.pem), print its SHA-256 fingerprint

TLS is never switched off (no curl -k; Claude Code auto mode blocks it too). A server before its public
launch has a self-signed certificate: pin it once with --pin, then the check trusts only that one
certificate (curl --cacert state/certs/<name>.pem). "resolve": "<ip>" in the service checks the name
on that IP before DNS points to it (curl --resolve). The pinned file is personal data (state/).
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "bin", "lib"))
try:
    import events as eventq                     # the shadow event queue (bin/lib/events.py): records, sends nothing
except Exception:                               # a status check that runs is worth more than its queue
    eventq = None
WORDS = {
    "uk": {"branch": "гілка", "dirty": "незбережено", "running": "іде", "missing": "шляху немає",
           "no_answer": "немає відповіді", "cert": "сертифікат не довірений",
           "after": "після", "before": "до", "known": "відома, в роботі",
           "unpinned": "не закріплений: bin/status --pin", "changed": "сертифікат не той, що закріплений",
           "gh_outage": "збій GitHub Actions", "maybe_gh": "можливо, збій GitHub, а не код",
           "conflict": "конфлікт з", "stale": "застарів", "days": "дн.",
           "unpushed": "⚠️ {n} гілок поза PR: {names}", "unpushed1": "⚠️ гілка поза PR: {names}",
           "dirty_wt": "⚠️ незбережено у {n} робочих копіях: {names}",
           "dirty_wt1": "⚠️ незбережено у робочій копії {names}",
           "no_group": "задачі без групи, проєкту немає в genius.config.json"},
    "en": {"branch": "branch", "dirty": "uncommitted", "running": "running", "missing": "path missing",
           "no_answer": "no answer", "cert": "certificate not trusted",
           "after": "after", "before": "before", "known": "known, in progress",
           "unpinned": "not pinned: bin/status --pin", "changed": "certificate is not the pinned one",
           "gh_outage": "GitHub Actions outage", "maybe_gh": "maybe GitHub, not the code",
           "conflict": "conflict with", "stale": "stale", "days": "d",
           "unpushed": "⚠️ {n} branches without a PR: {names}", "unpushed1": "⚠️ branch without a PR: {names}",
           "dirty_wt": "⚠️ uncommitted in {n} worktrees: {names}", "dirty_wt1": "⚠️ uncommitted in worktree {names}",
           "no_group": "tasks with no group, their project is not in genius.config.json"},
}
W = WORDS["en"]
# genius-ai itself: the project name its own operations carry (the user's decision of 2026-11-18)
SELF = "genius-ai"
SELF_TAG = "⚙️ GA"
SELF_SPOKEN = {"uk": "Геніус", "en": "Genius"}


def sh(*args, cwd=None, timeout=20, env=None):
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def url_check(url):
    try:
        req = urllib.request.Request(url, method="GET", headers={"user-agent": "genius-ai-status"})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except urllib.error.URLError as e:
        import ssl
        if isinstance(e.reason, ssl.SSLCertVerificationError):
            return "cert"                       # TLS is checked, never switched off; the cert is not trusted
        return 0
    except Exception:
        return 0


def transition(source, project, subject, bad, bad_word, good_word, what, url=""):
    """One change of one subject, bad → good or good → bad, goes to the shadow event queue
    (bin/lib/events.py): recorded, sent nowhere. The first sighting only sets the baseline, and a repeated
    state raises no event, so the queue holds transitions and not levels. A failure of the queue never
    fails the check."""
    if eventq is None:
        return
    try:
        prev = eventq.mark(source, subject, "down" if bad else "ok")
        if prev is None or (prev == "down") == bad:
            return
        eventq.emit(source, subject, bad_word if bad else good_word, project=project,
                    text=f"{what} {bad_word if bad else good_word}", data={"url": url} if url else {})
    except Exception:
        pass


def gh_env(repo, services):
    """The environment for `gh` on this repo: the token of the account that the config names for it.

    A machine can hold several gh logins; a private repo answers 404 to the wrong one. The active
    login is never switched: the token goes to this one call through GH_TOKEN.
    """
    for s in services:
        if s.get("type") == "github" and s.get("account") and repo in (s.get("repos") or []):
            token = sh("gh", "auth", "token", "--user", s["account"])
            if token:
                return {**os.environ, "GH_TOKEN": token}
    return None


def release_window(rule):
    """`"release": {"after": "19:00", "before": "23:00", "tz": "Europe/Kyiv"}` in project.json → open now or not."""
    if not isinstance(rule, dict) or not (rule.get("after") or rule.get("before")):
        return None
    from datetime import datetime
    try:
        from zoneinfo import ZoneInfo
        now = datetime.now(ZoneInfo(rule["tz"])) if rule.get("tz") else datetime.now()
    except Exception:
        now = datetime.now()
    hm = now.strftime("%H:%M")
    after, before = rule.get("after", "00:00"), rule.get("before", "24:00")
    text = " ".join(x for x in (rule.get("after") and f"{W['after']} {after}", rule.get("before") and f"{W['before']} {before}") if x)
    return {"open": after <= hm < before, "text": text}


CERTS = os.path.join(ROOT, "state", "certs")


def cert_file(service):
    return os.path.join(CERTS, re.sub(r"[^A-Za-z0-9._-]+", "-", service["name"]).strip("-") + ".pem")


def curl_check(s):
    """A pinned certificate and/or a fixed IP: curl checks TLS against that file only (never -k)."""
    u = urllib.parse.urlsplit(s["url"])
    args = ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10"]
    if os.path.exists(cert_file(s)):
        args += ["--cacert", cert_file(s)]
    if s.get("resolve"):
        args += ["--resolve", f"{u.hostname}:{u.port or 443}:{s['resolve']}"]
    try:
        r = subprocess.run(args + [s["url"]], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if r.returncode in (35, 51, 58, 60, 77, 83, 90, 91):   # TLS: the certificate does not match the pinned one
        return "changed" if os.path.exists(cert_file(s)) else "cert"
    return int(r.stdout or 0) if r.returncode == 0 else 0


def pin(name):
    """Fetch the certificate chain the server shows and store it as the only trusted one for this service."""
    cfg = read_json(os.path.join(ROOT, "genius.config.json"), {})
    s = next((x for x in cfg.get("services") or [] if x.get("name") == name), None)
    if not s or not s.get("url", "").startswith("https://"):
        print(f"no https service named «{name}» in genius.config.json")
        return 2
    u = urllib.parse.urlsplit(s["url"])
    target = f"{s.get('resolve') or u.hostname}:{u.port or 443}"
    r = subprocess.run(["openssl", "s_client", "-connect", target, "-servername", u.hostname, "-showcerts"],
                       input="", capture_output=True, text=True, timeout=20)
    pems = re.findall(r"-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----", r.stdout, re.S)
    if not pems:
        print(f"no certificate from {target}: {r.stderr.strip()[-200:]}")
        return 1
    os.makedirs(CERTS, exist_ok=True)
    with open(cert_file(s), "w") as f:
        f.write("\n".join(pems) + "\n")
    info = subprocess.run(["openssl", "x509", "-noout", "-subject", "-enddate", "-fingerprint", "-sha256"],
                          input=pems[0], capture_output=True, text=True).stdout.strip()
    print(f"pinned {len(pems)} certificate(s) of {target} → {os.path.relpath(cert_file(s), ROOT)}\n{info}")
    print("Compare the fingerprint with the one on the server before you trust it "
          "(on the server: openssl x509 -in <cert> -noout -fingerprint -sha256).")
    return 0


def github_status():
    """GitHub's own status page: the state of «Actions» and the open incidents. {} when unreachable."""
    try:
        with urllib.request.urlopen("https://www.githubstatus.com/api/v2/summary.json", timeout=8) as r:
            d = json.load(r)
    except Exception:
        return {}
    actions = next((c["status"] for c in d.get("components", []) if c.get("name") == "Actions"), "unknown")
    incidents = [i.get("name", "?") for i in d.get("incidents", []) if i.get("status") != "resolved"]
    return {"actions": actions, "incidents": incidents}


def blocked_tickets(name, tracker):
    """Tickets of a project's tracker that stand blocked: [(key, status, summary, url)].

    The user's decision of 2026-11-16: a blocked ticket is a problem, red and on top of Attention like a
    failed CI run. `projects/<name>/project.json`:
        "tracker": {"type": "jira", "blocked_jql": "project = X AND status in (Blocked)", "env_file": "~/path/to/.env"}
    Credentials are JIRA_URL, JIRA_USERNAME, JIRA_API_TOKEN from the environment, else from `env_file`
    (KEY=value lines); none is ever written to the config. Read-only, and cached for two minutes in
    state/tracker-cache.json: the panel asks often, the tracker must not be."""
    if not isinstance(tracker, dict) or tracker.get("type") != "jira" or not tracker.get("blocked_jql"):
        return []
    cache_path = os.path.join(ROOT, "state", "tracker-cache.json")
    cache = read_json(cache_path, {})
    hit = cache.get(name)
    if hit and hit.get("jql") == tracker["blocked_jql"] and time.time() - hit.get("at", 0) < 120:
        return [tuple(r) for r in hit.get("rows", [])]
    env = {k: os.environ.get(k, "") for k in ("JIRA_URL", "JIRA_USERNAME", "JIRA_API_TOKEN")}
    if not all(env.values()) and tracker.get("env_file"):
        try:
            with open(os.path.expanduser(tracker["env_file"]), encoding="utf-8") as f:
                for line in f:
                    m = re.match(r"\s*(?:export\s+)?(JIRA_URL|JIRA_USERNAME|JIRA_API_TOKEN)\s*=\s*(.*)", line)
                    if m and not env[m.group(1)]:
                        env[m.group(1)] = m.group(2).strip().strip("\"'")
        except OSError:
            pass
    if not all(env.values()):
        return [tuple(r) for r in (hit or {}).get("rows", [])]
    import base64
    base = env["JIRA_URL"].rstrip("/")
    query = urllib.parse.urlencode({"jql": tracker["blocked_jql"], "fields": "summary,status", "maxResults": 50})
    req = urllib.request.Request(f"{base}/rest/api/3/search/jql?{query}", headers={
        "Accept": "application/json",
        "Authorization": "Basic " + base64.b64encode(f"{env['JIRA_USERNAME']}:{env['JIRA_API_TOKEN']}".encode()).decode()})
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            issues = json.load(r).get("issues", [])
    except (OSError, ValueError):
        return [tuple(r) for r in (hit or {}).get("rows", [])]   # the tracker did not answer: keep the last answer
    rows = [(i["key"], i["fields"]["status"]["name"], i["fields"].get("summary") or "", f"{base}/browse/{i['key']}")
            for i in issues]
    cache[name] = {"at": time.time(), "jql": tracker["blocked_jql"], "rows": rows}
    try:
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False)
    except OSError:
        pass
    return rows


PR_FIELDS = "number,url,isDraft,mergeable,mergeStateStatus,updatedAt,baseRefName,headRefName"


def open_prs(repo, env):
    """Open PRs of a repo with the fields the conflict check needs: ONE `gh pr list` call, cached for
    two minutes in state/pr-cache.json (the panel asks often). GitHub computes `mergeable` lazily:
    a PR with UNKNOWN is asked again once, alone (`gh pr view`), after a short wait. None when gh fails."""
    cache_path = os.path.join(ROOT, "state", "pr-cache.json")
    cache = read_json(cache_path, {})
    hit = cache.get(repo) or {}
    if time.time() - hit.get("at", 0) < 120 and isinstance(hit.get("prs"), list):
        return hit["prs"]
    out = sh("gh", "pr", "list", "--repo", repo, "--state", "open", "--limit", "100", "--json", PR_FIELDS, env=env)
    try:
        prs = json.loads(out) if out else None
    except ValueError:
        prs = None
    if prs is None:
        return hit.get("prs")          # gh failed: the last answer, or nothing
    unknown = [x for x in prs if x.get("mergeable") == "UNKNOWN"]
    if unknown:
        time.sleep(2)
        for x in unknown:
            again = sh("gh", "pr", "view", str(x["number"]), "--repo", repo, "--json",
                       "mergeable,mergeStateStatus", env=env)
            try:
                x.update(json.loads(again))
            except ValueError:
                pass
    cache[repo] = {"at": time.time(), "prs": prs}
    try:
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False)
    except OSError:
        pass
    return prs


def pr_findings(prs, stale_days=3, now=None):
    """(problems, notes) from the open PRs. problems: [(text, url, data)]; data = {"kind": "pr_conflict",
    "number", "base"} (the panel's «resolve» button; the caller adds "repo").
    Conflict = mergeable CONFLICTING or mergeStateStatus DIRTY. UNKNOWN (still not computed after the
    retry) is skipped silently, never shown as a conflict. Stale = no update for `stale_days` days AND
    mergeStateStatus BEHIND (the head is behind its base); a conflicting PR is only a problem."""
    from datetime import datetime, timezone
    now = now or datetime.now(timezone.utc)
    problems, notes = [], []
    for x in prs or []:
        n, base, url = x.get("number"), x.get("baseRefName") or "?", x.get("url", "")
        if x.get("mergeable") == "CONFLICTING" or x.get("mergeStateStatus") == "DIRTY":
            problems.append((f"⚔️ PR #{n}: {W['conflict']} {base}", url,
                             {"kind": "pr_conflict", "number": n, "base": base}))
            continue
        if x.get("mergeStateStatus") != "BEHIND":
            continue
        try:
            age = (now - datetime.fromisoformat(x["updatedAt"].replace("Z", "+00:00"))).days
        except (KeyError, ValueError):
            continue
        if age > stale_days:
            notes.append(f"🕸 PR #{n}: {W['stale']} ({age} {W['days']}, {base})")
    return problems, notes


UNPUSHED_TTL = 600                                  # 10 min: the panel asks often, git is not cheap
# Noise on a worktree is not work: a generated file, a dependency folder, a scratch note (the user's
# decision of 2026-11-20).
IGNORED_UNCOMMITTED = re.compile(
    r"(^|/)(next-env\.d\.ts|\.doc-index|tmp|node_modules|\.brief\.md|\.brand-profile-source\.png|\.tmp-[^/]*|\.venv|\.cache)(/|$)")
# A long-lived integration branch is not work outside a PR (the user's decision of 2026-11-20);
# project.json → "integration": ["release"] adds the project's own.
INTEGRATION = {"main", "master", "develop", "development", "dev", "staging", "release", "production", "prod"}


def default_branch(path):
    """origin's default branch: from origin/HEAD, else the first of main, develop, master, dev that exists."""
    ref = sh("git", "-C", path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if ref.startswith("origin/"):
        return ref[len("origin/"):]
    for cand in ("main", "develop", "master", "dev"):
        if sh("git", "-C", path, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{cand}"):
            return cand
    return ""


def worktree_list(text):
    """`git worktree list --porcelain` → [{"path", "branch"}]; a detached worktree has branch ""."""
    out = []
    for block in (text or "").split("\n\n"):
        path, branch = "", ""
        for line in block.splitlines():
            if line.startswith("worktree "):
                path = line[len("worktree "):].strip()
            elif line.startswith("branch "):
                branch = line[len("branch "):].strip().removeprefix("refs/heads/")
        if path:
            out.append({"path": path, "branch": branch})
    return out


def dirty_files(text):
    """`git status --porcelain` → the files, minus next-env.d.ts, .doc-index and tmp/ (the project's noise)."""
    files = []
    for line in (text or "").splitlines():
        # sh() strips the output, so the first line can lose its leading space (" M x" → "M x"):
        # drop the status code by shape, not by a fixed 3 characters (the lesson of 2026-11-20)
        name = re.sub(r"^\s*[MADRCU?!T ]{1,2}\s+", "", line) if line.strip() else ""
        for part in name.split(" -> "):              # "R  old -> new" counts both names
            part = part.strip().strip('"')
            if part and not IGNORED_UNCOMMITTED.search(part):
                files.append(part)
    return files


def cherry_extra(text):
    """`git cherry <base> <branch>` → the commits that the base does not hold even as a patch ("+" lines)."""
    return [l[2:].strip() for l in (text or "").splitlines() if l.startswith("+ ")]


def ahead_of(path, base_ref):
    """{branch: commits ahead of base_ref} in ONE `git for-each-ref` (ahead-behind, git 2.41); an older
    git prints the format literally, then every branch is counted alone."""
    refs = sh("git", "-C", path, "for-each-ref", "--format=%(refname:short) %(ahead-behind:" + base_ref + ")",
              "refs/heads")
    ahead = {}
    for line in refs.splitlines():
        parts = line.rsplit(" ", 2)
        if len(parts) == 3 and parts[1].isdigit() and parts[2].isdigit():
            ahead[parts[0]] = int(parts[1])
    if ahead:
        return ahead
    names = sh("git", "-C", path, "for-each-ref", "--format=%(refname:short)", "refs/heads").splitlines()
    return {b.strip(): 1 for b in names if b.strip()}


def branches_without_pr(path, base, base_ref, heads, skip=()):
    """[{"branch", "commits"}] — branches with commits that origin/<base> does not hold even as a patch
    (`git cherry`: "+" only), and that no open PR has as its head. Integration branches are left out."""
    counts = ahead_of(path, base_ref)
    skip = set(skip) | {base}
    candidates = [b for b in counts if b not in skip and b not in heads and counts[b] > 0]
    if not candidates:
        return []
    def extra(branch):
        return cherry_extra(sh("git", "-C", path, "cherry", base_ref, branch))
    with ThreadPoolExecutor(max_workers=6) as pool:
        found = list(pool.map(extra, candidates))
    return [{"branch": b, "commits": len(x)} for b, x in zip(candidates, found) if x]


def live_agent_dirs():
    """Folders where a live Herdr agent works now: its worktree is work in progress, not forgotten work."""
    try:
        data = json.loads(sh("hc", "ls", "--json") or sh("hc", "ls") or "{}")
    except ValueError:
        return []
    out = []
    for t in data.get("terminals") or []:
        if t.get("state") == "live" and t.get("agent") == "claude-code" and t.get("cwd"):
            out.append(os.path.realpath(t["cwd"]))
    return out


def unpushed(path, name, repo, env=None, meta=None):
    """Branches and worktrees whose work waits only on this Mac: no PR, not in origin/<default>.

    The owner's goal of 2026-11-20: work that nobody sees is work that nobody merges. A branch counts
    when `git cherry origin/<default> <branch>` shows a commit ("+" only: a cherry-picked or rebased
    branch is not flagged) and no open PR has it as its head. A worktree counts when it holds
    uncommitted files other than next-env.d.ts, .doc-index and tmp/. One `gh pr list` per repo (the
    PR cache of this script); the answer is cached for 10 minutes in state/unpushed-cache.json, and
    the per-branch and per-worktree git calls run in parallel."""
    cache_path = os.path.join(ROOT, "state", "unpushed-cache.json")
    cache = read_json(cache_path, {})
    hit = cache.get(name) or {}
    if hit.get("repo") == repo and time.time() - hit.get("at", 0) < UNPUSHED_TTL:
        return hit.get("data") or {"branches": [], "worktrees": []}
    data = {"branches": [], "worktrees": []}
    base = default_branch(path)
    base_ref = f"origin/{base}" if base else ""
    if base_ref and sh("git", "-C", path, "rev-parse", "--verify", "--quiet", base_ref):
        prs = open_prs(repo, env) if repo else []
        # `gh` did not answer (None): a branch is not proven to have no PR, so nothing is called unpushed
        heads = {x.get("headRefName") for x in prs or [] if x.get("headRefName")} if prs is not None else None
        if heads is not None:
            # a branch whose PR was merged (any base) is landed, even when the local origin/* ref is stale
            merged = sh("gh", "pr", "list", "--repo", repo, "--state", "merged", "--limit", "200",
                        "--json", "headRefName", "-q", ".[].headRefName", env=env) if repo else ""
            heads = set(heads) | {h for h in merged.split() if h}
            skip = INTEGRATION | set((meta or {}).get("integration") or [])
            data["branches"] = branches_without_pr(path, base, base_ref, heads, skip)
    busy = live_agent_dirs()
    trees = [w for w in worktree_list(sh("git", "-C", path, "worktree", "list", "--porcelain"))
             if os.path.realpath(w["path"]) != os.path.realpath(path)
             and not any(os.path.realpath(w["path"]).startswith(d) for d in busy)]
    def dirty(wt):
        return dirty_files(sh("git", "-C", wt["path"], "status", "--porcelain"))
    if trees:                           # the main checkout is left out: its count is already in the info line
        with ThreadPoolExecutor(max_workers=6) as pool:
            for wt, files in zip(trees, list(pool.map(dirty, trees))):
                if files:
                    data["worktrees"].append({"path": wt["path"], "branch": wt["branch"],
                                              "count": len(files), "files": files[:8]})
    cache[name] = {"at": time.time(), "repo": repo, "data": data}
    try:
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False)
    except OSError:
        pass
    return data


def unpushed_findings(found, w=None):
    """(text, data) for the project's card: one line for the branches, one for the dirty worktrees."""
    w = w or W
    out = []
    branches = (found or {}).get("branches") or []
    if branches:
        names = ", ".join(b["branch"] for b in branches[:3]) + (" …" if len(branches) > 3 else "")
        key = "unpushed1" if len(branches) == 1 else "unpushed"
        out.append((w[key].format(n=len(branches), names=names),
                    {"kind": "unpushed", "branches": branches, "worktrees": (found or {}).get("worktrees") or []}))
    trees = (found or {}).get("worktrees") or []
    if trees:
        names = ", ".join(os.path.basename(t["path"]) for t in trees[:3]) + (" …" if len(trees) > 3 else "")
        key = "dirty_wt1" if len(trees) == 1 else "dirty_wt"
        out.append((w[key].format(n=len(trees), names=names),
                    {"kind": "worktree_dirty", "worktrees": trees}))
    return out


def selftest():
    from datetime import datetime, timezone, timedelta
    now = datetime(2026, 11, 17, 12, 0, tzinfo=timezone.utc)
    ago = lambda d: (now - timedelta(days=d)).strftime("%Y-%m-%dT%H:%M:%SZ")
    pr = lambda n, mg, ms, d=0: {"number": n, "url": f"u{n}", "mergeable": mg, "mergeStateStatus": ms,
                                 "updatedAt": ago(d), "baseRefName": "main"}
    prs = [pr(1, "CONFLICTING", "DIRTY"), pr(2, "MERGEABLE", "DIRTY"), pr(3, "UNKNOWN", "UNKNOWN", 30),
           pr(4, "MERGEABLE", "CLEAN", 30), pr(5, "MERGEABLE", "BEHIND", 5), pr(6, "MERGEABLE", "BEHIND", 1),
           pr(7, "CONFLICTING", "DIRTY", 9)]
    global W
    W = WORDS["uk"]
    problems, notes = pr_findings(prs, 3, now)
    assert [(t, u) for t, u, _ in problems] == [("⚔️ PR #1: конфлікт з main", "u1"), ("⚔️ PR #2: конфлікт з main", "u2"),
                                              ("⚔️ PR #7: конфлікт з main", "u7")], problems
    assert problems[0][2] == {"kind": "pr_conflict", "number": 1, "base": "main"}, problems[0]
    assert notes == ["🕸 PR #5: застарів (5 дн., main)"], notes      # #3 UNKNOWN skipped, #4 not behind, #6 fresh, #7 only a problem
    assert pr_findings(prs, 10, now)[1] == []                         # N is a parameter (stale_pr_days)
    assert pr_findings(None, 3, now) == ([], []) and pr_findings([], 3, now) == ([], [])
    # genius-ai's own tasks: their own group in Attention, none while there is nothing of its own
    # (the user's decision of 2026-11-18: with every project paused the panel said «all calm»)
    assert self_state([], "uk") is None and self_state([{"project": "lw", "what": "x"}], "uk") is None
    mine = [{"id": "a", "project": SELF, "what": "перша задача", "needs": "user", "ask": "вмикати?",
             "answers": ["yes", "no"]},
            {"id": "b", "project": SELF, "what": "друга задача", "queue": "next"}]
    g = self_state(mine, "uk")
    assert g["name"] == SELF and g["tag"] == "⚙️ GA" and g["spoken"] == "Геніус" and g["rank"] == 0, g
    assert g["self"] is True and g["paused"] is False and g["problems"] == [] and g["urls"] == [], g
    assert g["ops"] == ["перша задача", "друга задача"], g["ops"]
    assert [(o["id"], o["needs_user"], o["queue"]) for o in g["ops_detail"]] == [("a", True, ""), ("b", False, "next")], g["ops_detail"]
    assert g["ops_detail"][0]["answers"] == ["yes", "no"] and g["ops_detail"][0]["ask"] == "вмикати?"
    assert self_state(mine, "en")["spoken"] == "Genius" and self_state(mine, "de")["spoken"] == "Genius"
    # an operation of a project that is in neither place is counted, never dropped in silence
    lost = orphans([{"id": "a", "project": "lw"}, {"id": "b", "project": SELF},
                    {"id": "c", "project": "ghost"}, {"id": "d"}], {"lw"})
    assert [o["id"] for o in lost] == ["c", "d"], lost
    W = WORDS["en"]
    assert pr_findings([pr(9, "CONFLICTING", "DIRTY")], 3, now)[0][0][0] == "⚔️ PR #9: conflict with main"

    # worktrees, uncommitted files and the patch-equivalent check (the owner's goal of 2026-11-20)
    porcelain = ("worktree /repo\nHEAD " + "a" * 40 + "\nbranch refs/heads/main\n\n"
                 "worktree /repo/.claude/worktrees/panel-motion\nHEAD " + "b" * 40 + "\n"
                 "branch refs/heads/panel-motion\n\n"
                 "worktree /repo-sibling\nHEAD " + "c" * 40 + "\ndetached\n")
    wts = worktree_list(porcelain)
    assert [w["path"] for w in wts] == ["/repo", "/repo/.claude/worktrees/panel-motion", "/repo-sibling"], wts
    assert [w["branch"] for w in wts] == ["main", "panel-motion", ""], wts
    assert worktree_list("") == []
    dirty = (" M apps/web/next-env.d.ts\n?? tmp/scratch.md\n M .doc-index/x.json\n"
             " M src/page.tsx\nR  old/name.ts -> new/name.ts\n?? src/tmpfile.ts\n")
    assert dirty_files(dirty) == ["src/page.tsx", "old/name.ts", "new/name.ts", "src/tmpfile.ts"], dirty_files(dirty)
    assert dirty_files("") == []
    noise = ("?? apps/web/.brief.md\n?? .brand-profile-source.png\n?? node_modules\n"
             "?? apps/api/.tmp-bc-create.ts\n?? apps/web/next-env.d.ts\n M src/real.ts\n")
    assert dirty_files(noise) == ["src/real.ts"], dirty_files(noise)
    assert {"develop", "main", "staging"} <= INTEGRATION, INTEGRATION
    assert cherry_extra("+ " + "d" * 40 + "\n- " + "e" * 40 + "\n") == ["d" * 40]
    assert cherry_extra("") == []

    W = WORDS["uk"]
    found = {"branches": [{"branch": "feat/a", "commits": 2}, {"branch": "feat/b", "commits": 1},
                          {"branch": "fix/c", "commits": 1}, {"branch": "feat/d", "commits": 3}],
             "worktrees": [{"path": "/repo/.claude/worktrees/panel-motion", "branch": "panel-motion",
                            "count": 2, "files": ["a.js", "b.js"]}]}
    texts = unpushed_findings(found)
    assert texts[0][0] == "⚠️ 4 гілок поза PR: feat/a, feat/b, fix/c …", texts[0][0]
    assert texts[0][1]["kind"] == "unpushed" and len(texts[0][1]["branches"]) == 4, texts[0][1]
    assert texts[1][0] == "⚠️ незбережено у робочій копії panel-motion", texts[1][0]
    assert texts[1][1]["kind"] == "worktree_dirty", texts[1][1]
    assert unpushed_findings({"branches": [{"branch": "x", "commits": 1}], "worktrees": []})[0][0] == "⚠️ гілка поза PR: x"
    assert unpushed_findings({"branches": [], "worktrees": []}) == []
    assert unpushed_findings({}) == []
    W = WORDS["en"]
    assert unpushed_findings({"branches": [], "worktrees": [{"path": "/r/wt", "branch": "b", "count": 1,
                                                             "files": ["x"]}]})[0][0] == "⚠️ uncommitted in worktree wt"
    W = WORDS["uk"]
    print("status selftest: ok")


def op_agent(o):
    """The sub-agent an operation follows: its `agent`, else the name in its check (`hc get <name>`)."""
    if o.get("agent"):
        return o["agent"]
    m = re.search(r"\bhc (?:get|read|wait) ([\w.-]+)", o.get("check", "") or "")
    return m.group(1) if m else ""


def ops_detail(mine):
    """One entry per operation, for the Herdr panel: the fields its rows and its buttons read."""
    return [{"id": o.get("id", ""), "what": o["what"], "waiting_for": o.get("waiting_for", ""),
             "next": o.get("next", ""), "started": o.get("started", ""), "needs_user": o.get("needs") == "user",
             "queue": o.get("queue", ""),
             # "ask": the exact short question to the user; "answers": the choices, shown as buttons
             "ask": o.get("ask", ""), "answers": o.get("answers") or [], "answered": o.get("answered") or None,
             "kind": o.get("kind", ""), "agent": op_agent(o),
             "paused": bool(o.get("paused"))} for o in mine]


def self_state(ops, language):
    """The built-in group of genius-ai's own tasks: the operations with "project": "genius-ai".

    The user's decision of 2026-11-18: they belong to no configured project, so Attention never showed
    them; with every project paused the panel said «all calm» while nine of them waited. This is an
    entry like a project, without git, PR or URL checks (there is no project). None while it has no
    operations. Tag «⚙️ GA», spoken «Геніус» (uk) / «Genius» (en), rank 0 — the first group in Attention.
    """
    mine = [o for o in ops if o.get("project") == SELF]
    if not mine:
        return None
    return {"name": SELF, "path": ROOT, "self": True, "tag": SELF_TAG,
            "spoken": SELF_SPOKEN.get(language, SELF_SPOKEN["en"]),
            "priority": None, "rank": 0, "paused": False, "hold": None, "notes": [],
            "release": None, "problems": [], "problem_urls": [], "problem_data": [],
            "known": [], "info": [], "links": {}, "urls": [],
            "ops": [o["what"] for o in mine], "ops_detail": ops_detail(mine)}


def orphans(ops, names):
    """Operations whose "project" is neither a configured project nor genius-ai: they have no group.

    They still show nowhere; the text form prints one line about them, so they are never dropped in
    silence like genius-ai's own tasks were (2026-11-18)."""
    return [o for o in ops if (o.get("project") or "") not in names | {SELF}]


def card_notes(name, card):
    """Extra lines for a project's card from its own read-only command.

    `projects/<name>/project.json`: "card": {"cmd": "<read-only command>", "every": 900}. Each line the
    command prints (at most 4) is shown on the card, e.g. «partner-shop: on disk 2.8.2, active 2.8.1».
    It prints nothing when all is as it should be. Runs in the genius-ai folder with a 20 s timeout;
    cached in state/card-cache.json for `every` seconds (default 900), and the last answer stays when
    the command fails."""
    if not isinstance(card, dict) or not card.get("cmd"):
        return []
    cache_path = os.path.join(ROOT, "state", "card-cache.json")
    cache = read_json(cache_path, {})
    hit = cache.get(name) or {}
    if hit.get("cmd") == card["cmd"] and time.time() - hit.get("at", 0) < int(card.get("every") or 900):
        return hit.get("lines", [])
    try:
        r = subprocess.run(["/bin/zsh", "-lc", card["cmd"]], cwd=ROOT, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return hit.get("lines", [])
    if r.returncode != 0:
        return hit.get("lines", [])
    lines = [l.strip()[:120] for l in r.stdout.splitlines() if l.strip()][:4]
    cache[name] = {"at": time.time(), "cmd": card["cmd"], "lines": lines}
    try:
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False)
    except OSError:
        pass
    return lines


def project_state(p, services, ops):
    name, path = p["name"], os.path.expanduser(p["path"])
    meta = read_json(os.path.join(ROOT, "projects", name, "project.json"), {})
    mine = [o for o in ops if o.get("project") == name]
    st = {"name": name, "path": path, "tag": meta.get("tag", name), "spoken": meta.get("spoken", name),
          "priority": meta.get("priority"), "rank": meta.get("rank"), "paused": bool(meta.get("paused")),
          # "hold": the user's «take nothing new»: still checked and reported, marked on the card
          "hold": meta.get("hold") or None, "notes": [],
          "release": release_window(meta.get("release")),
          "problems": [], "problem_urls": [], "problem_data": [], "known": [], "info": [], "links": {}, "urls": [],
          "ops": [o["what"] for o in mine],
          # for the Herdr panel: "needs": "user" marks an operation that waits for the user's own action
          "ops_detail": ops_detail(mine)}

    def problem(text, url="", data=None):
        # `data` (optional): structure for a panel button, e.g. {"kind": "pr_conflict", "repo", "number", "base"};
        # parallel to `problems`, None for a plain problem
        st["problems"].append(text)
        st["problem_urls"].append(url)
        st["problem_data"].append(data)

    # Tool limits (the user's decision of 2026-11-15: «чому ліміт Codex не червоним в Attention?»):
    # state/limits.json [{"tool": "Codex", "until": "<ISO>", "project": "<name>", "note": "..."}];
    # an active one is a problem of its project until `until` passes.
    from datetime import datetime as _dt
    for lim in read_json(os.path.join(ROOT, "state", "limits.json"), []):
        if lim.get("project") != name:
            continue
        try:
            until = _dt.fromisoformat(lim["until"])
        except (KeyError, ValueError):
            continue
        if until > _dt.now(until.tzinfo):
            problem(f"⛔ {lim.get('tool', '?')}: ліміт до {until.strftime('%H:%M')} — {lim.get('note', 'генерації стоять')}")

    if st["paused"]:                # the user paused it: no git, GitHub or URL checks, no reports
        return st
    # Blocked tickets of the project's tracker: each one is a problem (red, on top of Attention). An
    # operation that «covers» the ticket's key moves it to «known, in progress» like any other problem.
    st["notes"] = card_notes(name, meta.get("card"))
    blocked = blocked_tickets(name, meta.get("tracker"))
    for key, status, summary, url in blocked[:6]:
        problem(f"🚫 {key}: {status} — {summary[:70]}", url)
    if len(blocked) > 6:
        problem(f"🚫 +{len(blocked) - 6} blocked: {', '.join(r[0] for r in blocked[6:16])}", "")
    if not os.path.isdir(path):
        problem(f"{W['missing']}: {p['path']}")
        return st
    branch = sh("git", "-C", path, "branch", "--show-current")
    dirty = sh("git", "-C", path, "status", "--porcelain")
    counts = sh("git", "-C", path, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    st["info"].append(f"{W['branch']} {branch or '?'}")
    if dirty:
        st["info"].append(f"{W['dirty']} {len(dirty.splitlines())}")
    if counts:
        behind, ahead = counts.split()
        if behind != "0" or ahead != "0":
            st["info"].append(f"↓{behind} ↑{ahead}")
    repo = sh("git", "-C", path, "remote", "get-url", "origin").removesuffix(".git")
    repo = repo.split("github.com")[-1].lstrip(":/") if "github.com" in repo else ""
    env = None
    if repo:
        env = gh_env(repo, services)
        st["links"] = {"repo": f"https://github.com/{repo}", "prs": f"https://github.com/{repo}/pulls",
                       "runs": f"https://github.com/{repo}/actions"}
        prs = open_prs(repo, env)
        if prs:
            st["info"].append(f"PR {len(prs)}")
            try:
                stale_days = int(meta.get("stale_pr_days", 3))
            except (TypeError, ValueError):
                stale_days = 3
            conflicts, stale = pr_findings(prs, stale_days)
            for text, url, data in conflicts:
                problem(text, url, {**data, "repo": repo})
            st["notes"].extend(stale)
        running = sh("gh", "run", "list", "--repo", repo, "--status", "in_progress", "--json", "name",
                     "-q", "[.[].name] | unique | join(\", \")", env=env)
        if running:
            st["info"].append(f"{W['running']}: {running}")
        # the latest run of EACH workflow on main: one broken workflow must not hide a green CI,
        # nor a green one hide a broken workflow (runs come newest first)
        runs = sh("gh", "run", "list", "--repo", repo, "--branch", "main", "--limit", "40", "--json",
                  "name,conclusion,url", "-q", ".[] | \"\\(.name)\\t\\(.conclusion)\\t\\(.url)\"", env=env)
        latest = {}
        for line in runs.splitlines():
            wf, _, rest = line.partition("\t")
            if wf and wf not in latest:
                latest[wf] = rest.split("\t")
        for wf, (conclusion, run_url) in latest.items():
            if conclusion == "failure":
                problem(f"main: {wf} failure", run_url)
            transition("status", name, f"{name}/ci/{wf}", conclusion == "failure", "failed", "recovered",
                       f"{st['tag']} main: {wf}", run_url)
    # Work that waits only on this Mac (the owner's goal of 2026-11-20): a branch outside every open PR
    # and a worktree with uncommitted files are invisible until someone names them.
    for text, data in unpushed_findings(unpushed(path, name, repo, env, meta)):
        problem(text, "", data)
    for s in services:
        if s.get("project") == name and s.get("type") == "url":
            started = time.time()
            pinned = s.get("expect") == "untrusted-cert" and os.path.exists(cert_file(s))
            code = curl_check(s) if pinned or s.get("resolve") else url_check(s["url"])
            ms = int((time.time() - started) * 1000)
            expected_cert = code == "cert" and s.get("expect") == "untrusted-cert"
            ok = expected_cert or (isinstance(code, int) and 200 <= code < 400)
            st["urls"].append({"name": s["name"], "url": s["url"], "ok": ok, "code": code, "ms": ms})
            if code == "changed":
                problem(f"{s['name']}: {W['changed']}", s["url"])
            elif expected_cert:
                st["info"].append(f"{s['name']}: {W['cert']}, {W['unpinned']} \"{s['name']}\"")
            elif code == "cert":            # not expected: the config does not say «untrusted-cert»
                problem(f"{s['name']}: {W['cert']}", s["url"])
            elif not ok:
                problem(f"{s['name']}: HTTP {code or W['no_answer']}", s["url"])
            transition("status", name, f"{name}/url/{s['name']}", not ok, "down", "back",
                       f"{st['tag']} {s['name']}", s["url"])
    return known_problems(st, mine)


def known_problems(st, mine):
    """A problem an open operation already tracks («covers»: a word of the problem's text) leaves
    the problems: it goes to «known» and to the info line with its ticket, so the panel's Attention
    shows only what nobody works on yet."""
    import re
    covered = [(c, o) for o in mine if not o.get("paused") for c in
               ([o["covers"]] if isinstance(o.get("covers"), str) else o.get("covers") or [])]
    keep, urls, datas, known = [], [], [], []
    for text, url, data in zip(st["problems"], st["problem_urls"], st["problem_data"]):
        hit = next((o for c, o in covered if c and c in text), None)
        if hit is None:
            keep.append(text); urls.append(url); datas.append(data); continue
        key = re.search(r"\b[A-Z][A-Z0-9]+-\d+\b", hit.get("what", ""))
        known.append(text)
        st["info"].append(f"{W['known']} {key.group(0) if key else hit.get('id', '')}: {text}")
    st["problems"], st["problem_urls"], st["problem_data"], st["known"] = keep, urls, datas, known
    return st


def main():
    global W
    if "--selftest" in sys.argv:
        return selftest()
    if "--pin" in sys.argv:
        i = sys.argv.index("--pin")
        sys.exit(pin(sys.argv[i + 1] if len(sys.argv) > i + 1 else ""))
    cfg = read_json(os.path.join(ROOT, "genius.config.json"), {})
    W = WORDS.get(cfg.get("language"), WORDS["en"])
    ops = read_json(os.path.join(ROOT, "state", "operations.json"), [])
    projects, services = cfg.get("projects") or [], cfg.get("services") or []
    with ThreadPoolExecutor(max_workers=4) as pool:
        gh_future = pool.submit(github_status) if projects else None
        states = list(pool.map(lambda p: project_state(p, services, ops), projects))
        gh = gh_future.result() if gh_future else {}
    # genius-ai's own tasks are one more group, first in Attention (the user's decision of 2026-11-18).
    # A config that names genius-ai as a project keeps that entry alone: two groups of one name collide.
    self_group = None if SELF in {p["name"] for p in projects} else self_state(ops, cfg.get("language"))
    if self_group:
        states.append(self_group)
    # `rank` in projects/<name>/project.json sets the order the user wants (1 first; the user's
    # decision of 2026-11-12: the focus project comes first in Attention and on the panel);
    # without it, the core project first, then the rest.
    states.sort(key=lambda s: (s["paused"], s["rank"] if s["rank"] is not None else 99,
                               s["priority"] != "core", not s["problems"]))
    outage = gh.get("actions") not in (None, "operational", "unknown")
    if outage:                                  # a failed run during an outage is not proof of a code bug
        for s in states:
            s["problems"] = [x + f" ({W['maybe_gh']})" if x.startswith("main: ") else x for x in s["problems"]]
    if "--json" in sys.argv:
        json.dump(states, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return
    if outage:
        print(f"🐙 GitHub · {W['gh_outage']}: Actions {gh['actions']}"
              + (" · " + "; ".join(gh["incidents"][:2]) if gh["incidents"] else "")
              + " · https://www.githubstatus.com")
    for s in states:
        if s["paused"]:             # silent in text; the Herdr panel (--json) shows it dimmed
            continue
        if "--line" in sys.argv:
            parts = s["problems"] + s["notes"] + s["info"][:3] + [f"⏳ {o}" for o in s["ops"][:2]]
            print(f"{s['tag']} · " + " · ".join(parts))
            continue
        # genius-ai's own group has no checks behind it: no mark, only its tasks
        print(f"{s['tag']}  ({s['name']})" + ("" if s.get("self") else "  ⚠️" if s["problems"] else "  ✅"))
        for x in s["problems"]:
            print(f"  ⚠️  {x}")
        if s["info"]:
            print("  " + " · ".join(s["info"]))
        for x in s["notes"]:
            print(f"  📌 {x}")
        for o in s["ops"]:
            print(f"  ⏳ {o}")
    # an operation of a project that is in neither place has no group to be shown in: one line, never silence
    lost = orphans(ops, {p["name"] for p in projects})
    if lost:
        ids = [f"{o.get('project') or '—'}/{o.get('id', '?')}" for o in lost]
        print(f"⏳ {W['no_group']}: {len(lost)} — {', '.join(ids[:6])}{f' (+{len(ids) - 6})' if len(ids) > 6 else ''}")


if __name__ == "__main__":
    main()
