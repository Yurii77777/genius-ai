#!/usr/bin/env python3
"""status — live state of every project and service in genius.config.json. Read-only, ~10 s.

    bin/status            one block per project (tag from projects/<name>/project.json), problems first
    bin/status --line     one short line per project (for the end of a reply)
    bin/status --json     machine-readable (the Herdr panel)

A project with "paused" in its project.json is not checked and not printed; --json keeps it, marked.

Per project: git branch, uncommitted files, ahead/behind upstream, open PRs, failed runs since the
last success, the running workflows, its URL services, and its pending operations (state/operations.json).
"""
import json
import os
import subprocess
import sys
import time
import urllib.request
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
WORDS = {
    "uk": {"branch": "гілка", "dirty": "незбережено", "running": "іде", "missing": "шляху немає",
           "no_answer": "немає відповіді", "cert": "сертифікат не довірений",
           "after": "після", "before": "до"},
    "en": {"branch": "branch", "dirty": "uncommitted", "running": "running", "missing": "path missing",
           "no_answer": "no answer", "cert": "certificate not trusted",
           "after": "after", "before": "before"},
}
W = WORDS["en"]


def sh(*args, cwd=None, timeout=20, env=None):
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def url_check(url):
    try:
        req = urllib.request.Request(url, method="GET", headers={"user-agent": "genius-ai-status"})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except urllib.error.URLError as e:
        import ssl
        if isinstance(e.reason, ssl.SSLCertVerificationError):
            return "cert"                       # TLS is checked, never switched off; the cert is not trusted
        return 0
    except Exception:
        return 0


def gh_env(repo, services):
    """The environment for `gh` on this repo: the token of the account that the config names for it.

    A machine can hold several gh logins; a private repo answers 404 to the wrong one. The active
    login is never switched: the token goes to this one call through GH_TOKEN.
    """
    for s in services:
        if s.get("type") == "github" and s.get("account") and repo in (s.get("repos") or []):
            token = sh("gh", "auth", "token", "--user", s["account"])
            if token:
                return {**os.environ, "GH_TOKEN": token}
    return None


def release_window(rule):
    """`"release": {"after": "19:00", "before": "23:00", "tz": "Europe/Kyiv"}` in project.json → open now or not."""
    if not isinstance(rule, dict) or not (rule.get("after") or rule.get("before")):
        return None
    from datetime import datetime
    try:
        from zoneinfo import ZoneInfo
        now = datetime.now(ZoneInfo(rule["tz"])) if rule.get("tz") else datetime.now()
    except Exception:
        now = datetime.now()
    hm = now.strftime("%H:%M")
    after, before = rule.get("after", "00:00"), rule.get("before", "24:00")
    text = " ".join(x for x in (rule.get("after") and f"{W['after']} {after}", rule.get("before") and f"{W['before']} {before}") if x)
    return {"open": after <= hm < before, "text": text}


def project_state(p, services, ops):
    name, path = p["name"], os.path.expanduser(p["path"])
    meta = read_json(os.path.join(ROOT, "projects", name, "project.json"), {})
    mine = [o for o in ops if o.get("project") == name]
    st = {"name": name, "path": path, "tag": meta.get("tag", name), "spoken": meta.get("spoken", name),
          "priority": meta.get("priority"), "paused": bool(meta.get("paused")),
          "release": release_window(meta.get("release")),
          "problems": [], "problem_urls": [], "info": [], "links": {}, "urls": [],
          "ops": [o["what"] for o in mine],
          # for the Herdr panel: "needs": "user" marks an operation that waits for the user's own action
          "ops_detail": [{"id": o.get("id", ""), "what": o["what"], "waiting_for": o.get("waiting_for", ""),
                          "next": o.get("next", ""), "started": o.get("started", ""), "needs_user": o.get("needs") == "user",
                          "paused": bool(o.get("paused"))} for o in mine]}

    def problem(text, url=""):
        st["problems"].append(text)
        st["problem_urls"].append(url)

    if st["paused"]:                # the user paused it: no git, GitHub or URL checks, no reports
        return st
    if not os.path.isdir(path):
        problem(f"{W['missing']}: {p['path']}")
        return st
    branch = sh("git", "-C", path, "branch", "--show-current")
    dirty = sh("git", "-C", path, "status", "--porcelain")
    counts = sh("git", "-C", path, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    st["info"].append(f"{W['branch']} {branch or '?'}")
    if dirty:
        st["info"].append(f"{W['dirty']} {len(dirty.splitlines())}")
    if counts:
        behind, ahead = counts.split()
        if behind != "0" or ahead != "0":
            st["info"].append(f"↓{behind} ↑{ahead}")
    repo = sh("git", "-C", path, "remote", "get-url", "origin").removesuffix(".git")
    repo = repo.split("github.com")[-1].lstrip(":/") if "github.com" in repo else ""
    if repo:
        env = gh_env(repo, services)
        st["links"] = {"repo": f"https://github.com/{repo}", "prs": f"https://github.com/{repo}/pulls",
                       "runs": f"https://github.com/{repo}/actions"}
        prs = sh("gh", "pr", "list", "--repo", repo, "--json", "number", "-q", "length", env=env)
        if prs:
            st["info"].append(f"PR {prs}")
        running = sh("gh", "run", "list", "--repo", repo, "--status", "in_progress", "--json", "name",
                     "-q", "[.[].name] | unique | join(\", \")", env=env)
        if running:
            st["info"].append(f"{W['running']}: {running}")
        last = sh("gh", "run", "list", "--repo", repo, "--branch", "main", "--limit", "1", "--json",
                  "name,conclusion,url", "-q", ".[0] | \"\\(.name) \\(.conclusion)\\t\\(.url)\"", env=env)
        last, _, run_url = last.partition("\t")
        if last.endswith(" failure"):
            problem(f"main: {last}", run_url)
    for s in services:
        if s.get("project") == name and s.get("type") == "url":
            started = time.time()
            code = url_check(s["url"])
            ms = int((time.time() - started) * 1000)
            expected_cert = code == "cert" and s.get("expect") == "untrusted-cert"
            ok = expected_cert or (code != "cert" and 200 <= code < 400)
            st["urls"].append({"name": s["name"], "url": s["url"], "ok": ok, "code": code, "ms": ms})
            if code == "cert":
                # expected only while the config says so (a server before its public launch)
                if expected_cert:
                    st["info"].append(f"{s['name']}: {W['cert']}")
                else:
                    problem(f"{s['name']}: {W['cert']}", s["url"])
            elif not ok:
                problem(f"{s['name']}: HTTP {code or W['no_answer']}", s["url"])
    return st


def main():
    global W
    cfg = read_json(os.path.join(ROOT, "genius.config.json"), {})
    W = WORDS.get(cfg.get("language"), WORDS["en"])
    ops = read_json(os.path.join(ROOT, "state", "operations.json"), [])
    projects, services = cfg.get("projects") or [], cfg.get("services") or []
    with ThreadPoolExecutor(max_workers=4) as pool:
        states = list(pool.map(lambda p: project_state(p, services, ops), projects))
    states.sort(key=lambda s: (s["paused"], s["priority"] != "core", not s["problems"]))
    if "--json" in sys.argv:
        json.dump(states, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return
    for s in states:
        if s["paused"]:             # silent in text; the Herdr panel (--json) shows it dimmed
            continue
        if "--line" in sys.argv:
            parts = s["problems"] + s["info"][:3] + [f"⏳ {o}" for o in s["ops"][:2]]
            print(f"{s['tag']} · " + " · ".join(parts))
            continue
        print(f"{s['tag']}  ({s['name']})" + ("  ⚠️" if s["problems"] else "  ✅"))
        for x in s["problems"]:
            print(f"  ⚠️  {x}")
        if s["info"]:
            print("  " + " · ".join(s["info"]))
        for o in s["ops"]:
            print(f"  ⏳ {o}")


if __name__ == "__main__":
    main()
