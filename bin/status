#!/usr/bin/env python3
"""status — live state of every project and service in genius.config.json. Read-only, ~10 s.

    bin/status            one block per project (tag from projects/<name>/project.json), problems first
    bin/status --line     one short line per project (for the end of a reply)
    bin/status --json     machine-readable (the Herdr panel)

A project with "paused" in its project.json is not checked and not printed; --json keeps it, marked.

Per project: git branch, uncommitted files, ahead/behind upstream, open PRs, failed runs since the
last success, the running workflows, its URL services, and its pending operations (state/operations.json).
Once per run: GitHub's own status (githubstatus.com, component «Actions»): during an outage a failed run
is marked as «maybe GitHub, not the code».

    bin/status --pin "<service name>"   fetch and store the certificate of a service with
                          "expect": "untrusted-cert" (state/certs/<name>.pem), print its SHA-256 fingerprint

TLS is never switched off (no curl -k; Claude Code auto mode blocks it too). A server before its public
launch has a self-signed certificate: pin it once with --pin, then the check trusts only that one
certificate (curl --cacert state/certs/<name>.pem). "resolve": "<ip>" in the service checks the name
on that IP before DNS points to it (curl --resolve). The pinned file is personal data (state/).
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
WORDS = {
    "uk": {"branch": "гілка", "dirty": "незбережено", "running": "іде", "missing": "шляху немає",
           "no_answer": "немає відповіді", "cert": "сертифікат не довірений",
           "after": "після", "before": "до", "known": "відома, в роботі",
           "unpinned": "не закріплений: bin/status --pin", "changed": "сертифікат не той, що закріплений",
           "gh_outage": "збій GitHub Actions", "maybe_gh": "можливо, збій GitHub, а не код"},
    "en": {"branch": "branch", "dirty": "uncommitted", "running": "running", "missing": "path missing",
           "no_answer": "no answer", "cert": "certificate not trusted",
           "after": "after", "before": "before", "known": "known, in progress",
           "unpinned": "not pinned: bin/status --pin", "changed": "certificate is not the pinned one",
           "gh_outage": "GitHub Actions outage", "maybe_gh": "maybe GitHub, not the code"},
}
W = WORDS["en"]


def sh(*args, cwd=None, timeout=20, env=None):
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def url_check(url):
    try:
        req = urllib.request.Request(url, method="GET", headers={"user-agent": "genius-ai-status"})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except urllib.error.URLError as e:
        import ssl
        if isinstance(e.reason, ssl.SSLCertVerificationError):
            return "cert"                       # TLS is checked, never switched off; the cert is not trusted
        return 0
    except Exception:
        return 0


def gh_env(repo, services):
    """The environment for `gh` on this repo: the token of the account that the config names for it.

    A machine can hold several gh logins; a private repo answers 404 to the wrong one. The active
    login is never switched: the token goes to this one call through GH_TOKEN.
    """
    for s in services:
        if s.get("type") == "github" and s.get("account") and repo in (s.get("repos") or []):
            token = sh("gh", "auth", "token", "--user", s["account"])
            if token:
                return {**os.environ, "GH_TOKEN": token}
    return None


def release_window(rule):
    """`"release": {"after": "19:00", "before": "23:00", "tz": "Europe/Kyiv"}` in project.json → open now or not."""
    if not isinstance(rule, dict) or not (rule.get("after") or rule.get("before")):
        return None
    from datetime import datetime
    try:
        from zoneinfo import ZoneInfo
        now = datetime.now(ZoneInfo(rule["tz"])) if rule.get("tz") else datetime.now()
    except Exception:
        now = datetime.now()
    hm = now.strftime("%H:%M")
    after, before = rule.get("after", "00:00"), rule.get("before", "24:00")
    text = " ".join(x for x in (rule.get("after") and f"{W['after']} {after}", rule.get("before") and f"{W['before']} {before}") if x)
    return {"open": after <= hm < before, "text": text}


CERTS = os.path.join(ROOT, "state", "certs")


def cert_file(service):
    return os.path.join(CERTS, re.sub(r"[^A-Za-z0-9._-]+", "-", service["name"]).strip("-") + ".pem")


def curl_check(s):
    """A pinned certificate and/or a fixed IP: curl checks TLS against that file only (never -k)."""
    u = urllib.parse.urlsplit(s["url"])
    args = ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10"]
    if os.path.exists(cert_file(s)):
        args += ["--cacert", cert_file(s)]
    if s.get("resolve"):
        args += ["--resolve", f"{u.hostname}:{u.port or 443}:{s['resolve']}"]
    try:
        r = subprocess.run(args + [s["url"]], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if r.returncode in (35, 51, 58, 60, 77, 83, 90, 91):   # TLS: the certificate does not match the pinned one
        return "changed" if os.path.exists(cert_file(s)) else "cert"
    return int(r.stdout or 0) if r.returncode == 0 else 0


def pin(name):
    """Fetch the certificate chain the server shows and store it as the only trusted one for this service."""
    cfg = read_json(os.path.join(ROOT, "genius.config.json"), {})
    s = next((x for x in cfg.get("services") or [] if x.get("name") == name), None)
    if not s or not s.get("url", "").startswith("https://"):
        print(f"no https service named «{name}» in genius.config.json")
        return 2
    u = urllib.parse.urlsplit(s["url"])
    target = f"{s.get('resolve') or u.hostname}:{u.port or 443}"
    r = subprocess.run(["openssl", "s_client", "-connect", target, "-servername", u.hostname, "-showcerts"],
                       input="", capture_output=True, text=True, timeout=20)
    pems = re.findall(r"-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----", r.stdout, re.S)
    if not pems:
        print(f"no certificate from {target}: {r.stderr.strip()[-200:]}")
        return 1
    os.makedirs(CERTS, exist_ok=True)
    with open(cert_file(s), "w") as f:
        f.write("\n".join(pems) + "\n")
    info = subprocess.run(["openssl", "x509", "-noout", "-subject", "-enddate", "-fingerprint", "-sha256"],
                          input=pems[0], capture_output=True, text=True).stdout.strip()
    print(f"pinned {len(pems)} certificate(s) of {target} → {os.path.relpath(cert_file(s), ROOT)}\n{info}")
    print("Compare the fingerprint with the one on the server before you trust it "
          "(on the server: openssl x509 -in <cert> -noout -fingerprint -sha256).")
    return 0


def github_status():
    """GitHub's own status page: the state of «Actions» and the open incidents. {} when unreachable."""
    try:
        with urllib.request.urlopen("https://www.githubstatus.com/api/v2/summary.json", timeout=8) as r:
            d = json.load(r)
    except Exception:
        return {}
    actions = next((c["status"] for c in d.get("components", []) if c.get("name") == "Actions"), "unknown")
    incidents = [i.get("name", "?") for i in d.get("incidents", []) if i.get("status") != "resolved"]
    return {"actions": actions, "incidents": incidents}


def project_state(p, services, ops):
    name, path = p["name"], os.path.expanduser(p["path"])
    meta = read_json(os.path.join(ROOT, "projects", name, "project.json"), {})
    mine = [o for o in ops if o.get("project") == name]
    st = {"name": name, "path": path, "tag": meta.get("tag", name), "spoken": meta.get("spoken", name),
          "priority": meta.get("priority"), "rank": meta.get("rank"), "paused": bool(meta.get("paused")),
          "release": release_window(meta.get("release")),
          "problems": [], "problem_urls": [], "known": [], "info": [], "links": {}, "urls": [],
          "ops": [o["what"] for o in mine],
          # for the Herdr panel: "needs": "user" marks an operation that waits for the user's own action
          "ops_detail": [{"id": o.get("id", ""), "what": o["what"], "waiting_for": o.get("waiting_for", ""),
                          "next": o.get("next", ""), "started": o.get("started", ""), "needs_user": o.get("needs") == "user",
                          "paused": bool(o.get("paused"))} for o in mine]}

    def problem(text, url=""):
        st["problems"].append(text)
        st["problem_urls"].append(url)

    if st["paused"]:                # the user paused it: no git, GitHub or URL checks, no reports
        return st
    if not os.path.isdir(path):
        problem(f"{W['missing']}: {p['path']}")
        return st
    branch = sh("git", "-C", path, "branch", "--show-current")
    dirty = sh("git", "-C", path, "status", "--porcelain")
    counts = sh("git", "-C", path, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    st["info"].append(f"{W['branch']} {branch or '?'}")
    if dirty:
        st["info"].append(f"{W['dirty']} {len(dirty.splitlines())}")
    if counts:
        behind, ahead = counts.split()
        if behind != "0" or ahead != "0":
            st["info"].append(f"↓{behind} ↑{ahead}")
    repo = sh("git", "-C", path, "remote", "get-url", "origin").removesuffix(".git")
    repo = repo.split("github.com")[-1].lstrip(":/") if "github.com" in repo else ""
    if repo:
        env = gh_env(repo, services)
        st["links"] = {"repo": f"https://github.com/{repo}", "prs": f"https://github.com/{repo}/pulls",
                       "runs": f"https://github.com/{repo}/actions"}
        prs = sh("gh", "pr", "list", "--repo", repo, "--json", "number", "-q", "length", env=env)
        if prs:
            st["info"].append(f"PR {prs}")
        running = sh("gh", "run", "list", "--repo", repo, "--status", "in_progress", "--json", "name",
                     "-q", "[.[].name] | unique | join(\", \")", env=env)
        if running:
            st["info"].append(f"{W['running']}: {running}")
        # the latest run of EACH workflow on main: one broken workflow must not hide a green CI,
        # nor a green one hide a broken workflow (runs come newest first)
        runs = sh("gh", "run", "list", "--repo", repo, "--branch", "main", "--limit", "40", "--json",
                  "name,conclusion,url", "-q", ".[] | \"\\(.name)\\t\\(.conclusion)\\t\\(.url)\"", env=env)
        latest = {}
        for line in runs.splitlines():
            wf, _, rest = line.partition("\t")
            if wf and wf not in latest:
                latest[wf] = rest.split("\t")
        for wf, (conclusion, run_url) in latest.items():
            if conclusion == "failure":
                problem(f"main: {wf} failure", run_url)
    for s in services:
        if s.get("project") == name and s.get("type") == "url":
            started = time.time()
            pinned = s.get("expect") == "untrusted-cert" and os.path.exists(cert_file(s))
            code = curl_check(s) if pinned or s.get("resolve") else url_check(s["url"])
            ms = int((time.time() - started) * 1000)
            expected_cert = code == "cert" and s.get("expect") == "untrusted-cert"
            ok = expected_cert or (isinstance(code, int) and 200 <= code < 400)
            st["urls"].append({"name": s["name"], "url": s["url"], "ok": ok, "code": code, "ms": ms})
            if code == "changed":
                problem(f"{s['name']}: {W['changed']}", s["url"])
            elif expected_cert:
                st["info"].append(f"{s['name']}: {W['cert']}, {W['unpinned']} \"{s['name']}\"")
            elif code == "cert":            # not expected: the config does not say «untrusted-cert»
                problem(f"{s['name']}: {W['cert']}", s["url"])
            elif not ok:
                problem(f"{s['name']}: HTTP {code or W['no_answer']}", s["url"])
    return known_problems(st, mine)


def known_problems(st, mine):
    """A problem an open operation already tracks («covers»: a word of the problem's text) leaves
    the problems: it goes to «known» and to the info line with its ticket, so the panel's Attention
    shows only what nobody works on yet."""
    import re
    covered = [(c, o) for o in mine if not o.get("paused") for c in
               ([o["covers"]] if isinstance(o.get("covers"), str) else o.get("covers") or [])]
    keep, urls, known = [], [], []
    for text, url in zip(st["problems"], st["problem_urls"]):
        hit = next((o for c, o in covered if c and c in text), None)
        if hit is None:
            keep.append(text); urls.append(url); continue
        key = re.search(r"\b[A-Z][A-Z0-9]+-\d+\b", hit.get("what", ""))
        known.append(text)
        st["info"].append(f"{W['known']} {key.group(0) if key else hit.get('id', '')}: {text}")
    st["problems"], st["problem_urls"], st["known"] = keep, urls, known
    return st


def main():
    global W
    if "--pin" in sys.argv:
        i = sys.argv.index("--pin")
        sys.exit(pin(sys.argv[i + 1] if len(sys.argv) > i + 1 else ""))
    cfg = read_json(os.path.join(ROOT, "genius.config.json"), {})
    W = WORDS.get(cfg.get("language"), WORDS["en"])
    ops = read_json(os.path.join(ROOT, "state", "operations.json"), [])
    projects, services = cfg.get("projects") or [], cfg.get("services") or []
    with ThreadPoolExecutor(max_workers=4) as pool:
        gh_future = pool.submit(github_status) if projects else None
        states = list(pool.map(lambda p: project_state(p, services, ops), projects))
        gh = gh_future.result() if gh_future else {}
    # `rank` in projects/<name>/project.json sets the order the user wants (1 first; the user's
    # decision of 2026-11-12: the focus project comes first in Attention and on the panel);
    # without it, the core project first, then the rest.
    states.sort(key=lambda s: (s["paused"], s["rank"] if s["rank"] is not None else 99,
                               s["priority"] != "core", not s["problems"]))
    outage = gh.get("actions") not in (None, "operational", "unknown")
    if outage:                                  # a failed run during an outage is not proof of a code bug
        for s in states:
            s["problems"] = [x + f" ({W['maybe_gh']})" if x.startswith("main: ") else x for x in s["problems"]]
    if "--json" in sys.argv:
        json.dump(states, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return
    if outage:
        print(f"🐙 GitHub · {W['gh_outage']}: Actions {gh['actions']}"
              + (" · " + "; ".join(gh["incidents"][:2]) if gh["incidents"] else "")
              + " · https://www.githubstatus.com")
    for s in states:
        if s["paused"]:             # silent in text; the Herdr panel (--json) shows it dimmed
            continue
        if "--line" in sys.argv:
            parts = s["problems"] + s["info"][:3] + [f"⏳ {o}" for o in s["ops"][:2]]
            print(f"{s['tag']} · " + " · ".join(parts))
            continue
        print(f"{s['tag']}  ({s['name']})" + ("  ⚠️" if s["problems"] else "  ✅"))
        for x in s["problems"]:
            print(f"  ⚠️  {x}")
        if s["info"]:
            print("  " + " · ".join(s["info"]))
        for o in s["ops"]:
            print(f"  ⏳ {o}")


if __name__ == "__main__":
    main()
