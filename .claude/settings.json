{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" 2>/dev/null || true",
            "timeout": 40,
            "statusMessage": "genius-ai: читаю конфіг"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/voice/lib/speak_reply.py\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/daylog.py\" hook 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/done_auto.py\" hook 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/know.py\" stop 2>/dev/null || true",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/know.py\" learn 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/voice/lib/sound_command.py\" 2>/dev/null || true",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/voice/lib/speak_reply.py\" stop 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/daylog.py\" hook 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/know.py\" hook 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/voice/lib/work_status.py\" 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/know.py\" step 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/bin/lib/statusline.py\" 2>/dev/null || true"
  }
}
